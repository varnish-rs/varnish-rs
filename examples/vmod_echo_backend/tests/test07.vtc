varnishtest "echo backend: pipe() is refused on TLS client sessions"

# PipeRequest::client() is the raw client socket, which carries ciphertext on
# a TLS session: the pipe must be refused before EchoBackend::pipe() gets to
# write plaintext into it, and accounted like a refusal (ReqAcct, no PipeAcct).
# example.com.pem is a self-signed test certificate.

shell {
    cat >${tmpdir}/tls.cfg <<EOF
frontend = {
    host = "${localhost}"
    port = "0"
    name = "tls0"
}
pem-file = "${testdir}/example.com.pem"
EOF
}

server s1 {} -start

varnish v1 -arg "-A ${tmpdir}/tls.cfg" -vcl+backend {
    import echo_backend from "${vmod}";

    sub vcl_init {
        new echo = echo_backend.new();
    }

    sub vcl_recv {
        set req.backend_hint = echo.backend();
        return (pipe);
    }
} -start

logexpect l1 -v v1 -g request {
    fail add *  PipeAcct
    fail add *  Timestamp   "^Pipe:"
    expect * *  ReqURL      "^/tls$"
    expect * =  Error       "^Backend does not support pipe: TLS session$"
    expect * =  ReqAcct     "^[1-9][0-9]* 0 [1-9][0-9]* 0 0 0$"
    expect * =  End
    fail clear
} -start

client c1 -connect ${v1_tls0_sock} {
    tls_handshake
    txreq -url "/tls"
    expect_close
} -run

logexpect l1 -wait

varnish v1 -expect MGT.child_panic == 0
varnish v1 -expect MAIN.sc_tx_error == 1
