varnishtest "pipe to a backend relying on the default VclBackend::pipe()"

# The default pipe() implementation doesn't support piping and returns
# StreamClose::TxError. The client fd it's handed is owned by Varnish, which
# closes it once pipe() returns: the Rust layer must not close it as well, or
# the second close() fails with EBADF and trips an assert in the child.

server s1 {} -start

varnish v1 -vcl+backend {
    import simple_backend from "${vmod}";

    sub vcl_init {
        new repeater = simple_backend.new("unused");
    }

    sub vcl_recv {
        set req.backend_hint = repeater.backend();
        return (pipe);
    }
} -start

logexpect l1 -v v1 -g raw {
    expect * * Error "Backend does not support pipe"
} -start

# A refused pipe is accounted like a request that was never piped: ReqAcct
# with the request header bytes, no PipeAcct nor Pipe timestamp.
logexpect l2 -v v1 -g request {
    fail add *  PipeAcct
    fail add *  Timestamp   "^Pipe:"
    expect * *  ReqURL      "^/pipe$"
    expect * =  ReqAcct     "^[1-9][0-9]* 0 [1-9][0-9]* 0 0 0$"
    expect * =  End
    fail clear
} -start

client c1 {
    txreq -url "/pipe"
    expect_close
} -run

client c2 {
    txreq -url "/pipe"
    expect_close
} -run

logexpect l1 -wait
logexpect l2 -wait

varnish v1 -expect MGT.child_panic == 0
varnish v1 -expect MAIN.sc_tx_error == 2
