varnishtest "&mut self methods restricted to vcl_init"

server s1 {} -start

varnish v1 -vcl+backend {
    import restricted_callsites from "${vmod}";

    sub vcl_init {
        new counter = restricted_callsites.counter();
        counter.add(2);
        counter.add(40);
    }

    sub vcl_recv {
        return (synth(200));
    }

    sub vcl_synth {
        set resp.http.x-counter = counter.get();
    }
} -start

client c1 {
    txreq
    rxresp
    expect resp.status == 200
    expect resp.http.x-counter == 42
} -run

# Mutating methods must not be callable from client subs
varnish v1 -errvcl "Not available in subroutine" {
    vcl 4.1;
    import restricted_callsites from "${vmod}";
    backend be none;
    sub vcl_init {
        new counter = restricted_callsites.counter();
    }
    sub vcl_recv {
        counter.add(1);
    }
}
