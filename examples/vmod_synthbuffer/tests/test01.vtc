varnishtest "synthbuffer.push()/push_reverse() from vcl_synth and vcl_backend_error"

server s1 {
    rxreq
    txresp
} -start

varnish v1 -vcl+backend {
    import synthbuffer from "${vmod}";

    backend fail_be none;

    sub vcl_recv {
        if (req.url == "/error") {
            set req.backend_hint = fail_be;
            return (pass);
        }
        return (synth(200));
    }

    sub vcl_synth {
        set resp.storage = storage.Transient;
        synthbuffer.push("hello ");
        synthbuffer.push_reverse("world");
        return (deliver);
    }

    sub vcl_backend_error {
        synthbuffer.push("hello ");
        synthbuffer.push_reverse("world");
        return (deliver);
    }
} -start

client c1 {
    txreq -url "/synth"
    rxresp
    expect resp.status == 200
    expect resp.body == "hello dlrow"
} -run

client c2 {
    txreq -url "/error"
    rxresp
    expect resp.status == 503
    expect resp.body == "hello dlrow"
} -run

# push()/push_reverse() are only allowed in vcl_synth/vcl_backend_error - calling
# them anywhere else must fail to compile.
varnish v1 -errvcl "Not available in subroutine" {
    vcl 4.1;
    import synthbuffer from "${vmod}";
    backend be none;
    sub vcl_recv {
        synthbuffer.push("nope");
    }
}
